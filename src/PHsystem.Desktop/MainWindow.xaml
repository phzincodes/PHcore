<Window x:Class="PHsystem.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:PHsystem.Desktop.Components"
        xmlns:views="clr-namespace:PHsystem.Desktop.Views"
        Title="PHsystem Next" Width="1400" Height="880" MinWidth="640" MinHeight="360"
        Loaded="WindowLoaded" SizeChanged="WindowSizeChanged" SourceInitialized="WindowSourceInitialized"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="{DynamicResource BodyFontSize}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        components:Motion.Enabled="{Binding Preferences.AnimationsEnabled}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
      <CollectionViewSource x:Key="NavigationSource">
        <CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="Group"/></CollectionViewSource.GroupDescriptions>
      </CollectionViewSource>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <Grid x:Name="AppShell" Background="{DynamicResource BackgroundBrush}">
      <Grid.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding OpenOverviewCommand}"/>
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding OpenDiagnosticsCommand}"/>
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding OpenCleanupCommand}"/>
        <KeyBinding Key="F5" Command="{Binding ScanCommand}"/>
      </Grid.InputBindings>
      <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding SidebarWidth}"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="14,14,10,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Width="36" Height="36" Style="{DynamicResource AccentIconTile}">
              <Grid>
                <TextBlock Text="PH" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image Source="{Binding Logo}" Stretch="Uniform" Margin="2"/>
              </Grid>
            </Border>
            <TextBlock Grid.Column="1" Text="PHsystem" FontWeight="SemiBold" FontSize="20" LineHeight="26"
                       VerticalAlignment="Center" Margin="11,0,0,0"
                       Visibility="{Binding SidebarExpanded, Converter={StaticResource BoolVisibility}}"/>
          </Grid>

          <ListBox x:Name="MainNavigation" Grid.Row="1" Style="{DynamicResource {x:Type ListBox}}"
                   ItemsSource="{Binding Source={StaticResource NavigationSource}}"
                   SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}" ItemContainerStyle="{DynamicResource NavigationItem}"
                   BorderThickness="0" Background="Transparent" Margin="8,0" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   AutomationProperties.AutomationId="MainNavigation" AutomationProperties.Name="Navegação principal">
            <ListBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.ContainerStyle>
                  <Style TargetType="GroupItem">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="GroupItem"><StackPanel><ContentPresenter/><ItemsPresenter/></StackPanel></ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </GroupStyle.ContainerStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" Style="{DynamicResource Eyebrow}" Margin="11,12,0,5"
                               Visibility="{Binding DataContext.SidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}"/>
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ToolTip="{Binding Title}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <components:IconControl Data="{Binding Icon}" Width="19" Height="19"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                             Visibility="{Binding DataContext.SidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}" Margin="8,4,8,0" Padding="0,7,0,8">
            <StackPanel>
              <Button Command="{Binding OpenAccountCommand}" Style="{DynamicResource SubtleAction}" Padding="0,4"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTip="{Binding AccountLabel}" AutomationProperties.Name="Conta da comunidade">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <components:IconControl Data="M12,12 A4,4 0 1 0 12,4 A4,4 0 1 0 12,12 M4,21 Q4,15 12,15 Q20,15 20,21"
                                          Width="17" Height="17" Stroke="{DynamicResource SecondaryBrush}"/>
                  <TextBlock Grid.Column="1" Margin="0,0,5,0" Text="{Binding AccountLabel}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                             Visibility="{Binding SidebarExpanded, Converter={StaticResource BoolVisibility}}"/>
                </Grid>
              </Button>
              <Button Command="{Binding ToggleSidebarCommand}" Style="{DynamicResource SubtleAction}" Padding="0,4"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTip="{Binding SidebarToggleLabel}"
                      AutomationProperties.Name="{Binding SidebarToggleLabel}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <components:IconControl Data="M4,5 H20 V19 H4 Z M10,5 V19 M13,12 H17" Width="18" Height="18" Stroke="{DynamicResource SecondaryBrush}"/>
                  <TextBlock Grid.Column="1" Text="{Binding SidebarToggleLabel}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                             Visibility="{Binding SidebarExpanded, Converter={StaticResource BoolVisibility}}"/>
                </Grid>
              </Button>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="24,19,24,17">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock Text="{Binding PageTitle}" Style="{DynamicResource Title}" AutomationProperties.AutomationId="PageTitle"/>
            <TextBlock Text="{Binding PageDescription}" Style="{DynamicResource Caption}" Margin="0,2,0,0"/>
          </StackPanel>
          <Button Grid.Column="1" Command="{Binding ScanCommand}" Style="{DynamicResource CompactAction}" VerticalAlignment="Center"
                  AutomationProperties.AutomationId="ScanButton" ToolTip="Atualizar diagnóstico · F5"
                  Visibility="{Binding ShowHeaderScan, Converter={StaticResource BoolVisibility}}">
            <StackPanel Orientation="Horizontal">
              <components:IconControl Data="M20,8 A8,8 0 1 0 20,16 M20,3 V8 H15" Stroke="{DynamicResource SecondaryBrush}" Width="15" Height="15" Margin="0,0,6,0"/>
              <TextBlock Text="Analisar" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>

        <components:AccessiblePageHost x:Name="PageHost" Grid.Row="1" Style="{StaticResource PageHost}"
                                       SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}" Margin="24,0,18,12" AutomationProperties.Name="Área de trabalho">
          <TabItem Header="Início"><views:OverviewView/></TabItem>
          <TabItem Header="Diagnóstico"><views:DiagnosticsView/></TabItem>
          <TabItem Header="Limpeza"><views:CleanupView/></TabItem>
          <TabItem Header="Armazenamento"><views:StorageView/></TabItem>
          <TabItem Header="Drivers"><views:DriversView/></TabItem>
          <TabItem Header="PH CORE"><views:RecommendationsView/></TabItem>
          <TabItem Header="Modo Jogo"><views:GameView/></TabItem>
          <TabItem Header="Histórico"><views:HistoryView/></TabItem>
          <TabItem Header="Comunidade"><views:CommunityShell/></TabItem>
          <TabItem Header="Privacidade"><views:PrivacyView/></TabItem>
          <TabItem Header="Hardware"><views:HardwareView/></TabItem>
          <TabItem Header="Segurança"><views:SecurityView/></TabItem>
          <TabItem Header="Desempenho"><views:PerformanceView/></TabItem>
          <TabItem Header="Configurações"><views:SettingsView/></TabItem>
        </components:AccessiblePageHost>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource SidebarBrush}" Padding="24,5,16,5">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Cancelar" Command="{Binding CancelCommand}" Style="{DynamicResource SubtleAction}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="9,0,0,0"/>
            <Ellipse DockPanel.Dock="Left" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,9,0">
              <Ellipse.Style>
                <Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource MutedBrush}"/>
                  <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Fill" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" Style="{DynamicResource Caption}" FontSize="11"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="OperationStatus" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
    <views:AuthenticationView x:Name="Authentication" Visibility="Collapsed"/>
  </Grid>
</Window>
