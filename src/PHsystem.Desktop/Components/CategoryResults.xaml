<UserControl x:Class="PHsystem.Desktop.Components.CategoryResults"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility" /></UserControl.Resources>
  <Grid>
    <Border Style="{DynamicResource TablePanel}">
      <ItemsControl ItemsSource="{Binding}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{DynamicResource DividerRow}" Padding="12,4">
              <Expander HorizontalContentAlignment="Stretch">
                <Expander.Header>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Border Style="{DynamicResource StateBadge}">
                      <TextBlock Text="{Binding State}" FontSize="11" />
                    </Border>
                  </StackPanel>
                </Expander.Header>
                <StackPanel Margin="8,8,8,5">
                  <DataGrid ItemsSource="{Binding Facts}" MaxHeight="310" AutomationProperties.Name="{Binding Name}">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Informação" Binding="{Binding Name}" Width="1*" />
                      <DataGridTemplateColumn Header="Valor" Width="2*" SortMemberPath="Value">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate><TextBlock Text="{Binding Value}" TextWrapping="Wrap" Margin="0,5" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                  <TextBlock Text="{Binding Errors}" Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,0"
                             Visibility="{Binding HasErrors, Converter={StaticResource BoolVisibility}}" />
                  <TextBlock Text="{Binding Source}" Style="{DynamicResource Caption}" Margin="0,7,0,0" />
                  <TextBlock Text="{Binding ExpiresAt}" Style="{DynamicResource Caption}" />
                </StackPanel>
              </Expander>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
    <Border Padding="14" Background="{DynamicResource InsetBrush}" CornerRadius="{DynamicResource PanelRadius}">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="Faça uma análise para consultar os dados coletados." Style="{DynamicResource Caption}" />
    </Border>
  </Grid>
</UserControl>
