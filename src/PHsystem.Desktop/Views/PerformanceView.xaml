<UserControl x:Class="PHsystem.Desktop.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:PHsystem.Desktop.Components">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility" /></UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,8,18">
      <components:ResponsivePanel MinimumColumnWidth="285" Gap="12" Margin="0,0,0,16">
        <Border Style="{DynamicResource HeroPanel}">
          <StackPanel>
            <TextBlock Text="Memória na última análise" Style="{DynamicResource Caption}" />
            <TextBlock Text="{Binding MemoryUsageLabel}" FontSize="21" FontWeight="SemiBold" Margin="0,4" />
            <ProgressBar Value="{Binding MemoryUsedPercent, Mode=OneWay}" Height="5" Margin="0,4,0,7"
                         Visibility="{Binding HasMemoryData, Converter={StaticResource BoolVisibility}}" />
            <TextBlock Text="{Binding MemoryDetail}" Style="{DynamicResource Caption}" />
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Panel}">
          <StackPanel>
            <TextBlock Text="Ajustes" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8" />
            <WrapPanel>
              <Button Content="Modo jogo" Command="{Binding OpenGameCommand}" Margin="0,0,8,6" />
              <Button Content="Apps de inicialização do Windows" Command="{Binding OpenStartupSettingsCommand}" Margin="0,0,0,6" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </components:ResponsivePanel>
      <TextBlock Text="Inicialização, serviços e rede" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8" />
      <components:CategoryResults DataContext="{Binding PerformanceCategories}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
