<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PHsystem.Desktop.Views.CommunityView" Unloaded="ViewUnloaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TabControl SelectedIndex="{Binding CommunityTabIndex, Mode=TwoWay}">
      <TabItem Header="Sessão">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding Community}" Margin="0,0,12,20">
            <Border Style="{DynamicResource HeroPanel}">
              <StackPanel>
                <DockPanel>
                  <Button Content="Sair da conta" Command="{Binding LogoutCommand}" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                  <TextBlock Text="{Binding Username}" Style="{DynamicResource SectionTitle}"/>
                </DockPanel>
              </StackPanel>
            </Border>
            <Expander Header="Excluir minha conta">
              <StackPanel Margin="0,12,0,0">
                <TextBlock Text="A exclusão remove ou anonimiza os dados públicos da conta. Digite sua senha para confirmar." Style="{DynamicResource Caption}"/>
                <CheckBox Content="Solicito a exclusão da minha conta" IsChecked="{Binding DeleteConsent}" Margin="0,7,0,0"/>
                <TextBlock Text="Senha atual" Style="{DynamicResource FieldLabel}" Margin="0,6,0,5"/>
                <PasswordBox x:Name="AccountPassword" PasswordChanged="AccountPasswordChanged" AutomationProperties.Name="Senha para excluir conta"/>
                <Button Content="Excluir conta" Click="DeleteAccountClick" Style="{DynamicResource DangerButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Mensagens">
        <Grid DataContext="{Binding Community}" IsEnabled="{Binding IsReady}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
          </Grid.ColumnDefinitions>
          <Border Style="{DynamicResource Panel}" Margin="0,0,10,0">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <Button Content="Atualizar" Command="{Binding LoadMessagesCommand}" DockPanel.Dock="Right"/>
                <TextBlock Text="Caixa de entrada" Style="{DynamicResource SectionTitle}"/>
              </DockPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{DynamicResource Notice}" Margin="0,0,0,10">
                        <TextBlock Text="{Binding}"/>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
              <Border Style="{DynamicResource Panel}">
                <StackPanel>
                  <TextBlock Text="Nova mensagem" Style="{DynamicResource SectionTitle}"/>
                  <TextBlock Text="ID do destinatário" Style="{DynamicResource FieldLabel}" Margin="0,18,0,6"/>
                  <TextBox Text="{Binding RecipientId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ID do destinatário"/>
                  <TextBlock Text="Mensagem" Style="{DynamicResource FieldLabel}" Margin="0,16,0,6"/>
                  <TextBox Text="{Binding MessageBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="2000" MinHeight="150" AutomationProperties.Name="Texto da mensagem"/>
                  <WrapPanel Margin="0,16,0,0">
                    <Button Content="Enviar mensagem" Command="{Binding SendMessageCommand}" Style="{DynamicResource PrimaryButton}" Margin="0,0,10,8"/>
                    <Button Content="Bloquear destinatário" Command="{Binding BlockCommand}" Style="{DynamicResource QuietButton}" Margin="0,0,0,8"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Expander Header="Preferências de mensagens" Margin="0,8,0,0">
                <Border Style="{DynamicResource Panel}" Margin="0,6,0,0">
                  <StackPanel Margin="0,6,0,0">
                    <CheckBox IsChecked="{Binding AcceptMessages}" Margin="0,12,0,8">
                      <TextBlock Text="Aceito receber mensagens diretas"/>
                    </CheckBox>
                    <Button Content="Salvar preferência" Command="{Binding MessagePrivacyCommand}" HorizontalAlignment="Left"/>
                    <TextBlock Text="As mensagens são armazenadas no servidor sem criptografia de ponta a ponta." Style="{DynamicResource Caption}" Margin="0,12,0,0"/>
                  </StackPanel>
                </Border>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Resumo local">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="860" HorizontalAlignment="Left">
            <Border Style="{DynamicResource Panel}">
              <StackPanel>
                <TextBlock Text="Resumo do diagnóstico" Style="{DynamicResource SectionTitle}"/>
                <TextBlock Text="Prévia local com os nomes e estados das categorias do diagnóstico." Style="{DynamicResource Caption}" Margin="0,8,0,18"/>
                <WrapPanel>
                  <Button Content="Preparar resumo" Command="{Binding PrepareDraftCommand}" Margin="0,0,10,8"/>
                  <Button Content="Salvar arquivo JSON" Command="{Binding ExportDraftCommand}" Margin="0,0,0,8"/>
                </WrapPanel>
                <Expander Header="Ver e copiar prévia" Margin="0,7,0,0">
                  <TextBox Text="{Binding CommunityText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="80" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0" AutomationProperties.Name="Resumo local para compartilhamento" MaxHeight="190"/>
                </Expander>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Compartilhamento">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding Community}" IsEnabled="{Binding IsReady}" Margin="0,0,12,20">
            <Border Style="{DynamicResource Panel}">
              <StackPanel>
                <DockPanel>
                  <Button Content="Preparar prévia" Command="{Binding PrepareSharingCommand}" DockPanel.Dock="Right" Margin="20,0,0,0"/>
                  <StackPanel>
                    <TextBlock Text="Dados do computador no perfil" Style="{DynamicResource SectionTitle}"/>
                    <TextBlock Text="Prepare a prévia e marque os campos que deseja publicar." Style="{DynamicResource Caption}" Margin="0,6,0,0"/>
                  </StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding ShareFields}" Margin="0,20,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition/>
                          </Grid.ColumnDefinitions>
                          <CheckBox Content="{Binding Label}" IsChecked="{Binding Selected}"/>
                          <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Margin="0,20,0,0">
                  <Button Content="Publicar campos selecionados" Command="{Binding PublishSharingCommand}" Style="{DynamicResource PrimaryButton}" Margin="0,0,10,8"/>
                  <Button Content="Retirar compartilhamento" Command="{Binding RevokeSharingCommand}" Margin="0,0,0,8"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="Somente os campos marcados são publicados. Retirar o compartilhamento preserva o diagnóstico local." Style="{DynamicResource Caption}" Margin="0,14,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="1">
      <TextBlock Text="{Binding Community.Status}" Style="{DynamicResource Caption}" AutomationProperties.LiveSetting="Polite" Margin="0,7,0,0"/>
    </Border>
  </Grid>
</UserControl>
