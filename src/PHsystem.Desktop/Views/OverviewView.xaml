<UserControl x:Class="PHsystem.Desktop.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:components="clr-namespace:PHsystem.Desktop.Components"
             xmlns:views="clr-namespace:PHsystem.Desktop.Views">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolVisibility" />
      <Style x:Key="OverviewCard" TargetType="ui:Card">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollViewer Style="{DynamicResource DarkScrollViewer}" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,8,8,16">
      <DockPanel Margin="0,0,0,13">
        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
          <Button Content="Interromper" Command="{Binding CancelCommand}" Style="{DynamicResource QuietButton}"
                  Visibility="{Binding IsScanning, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,0" />
          <Button Content="Analisar PC" Command="{Binding ScanCommand}" Style="{DynamicResource PrimaryButton}"
                  MinWidth="125" AutomationProperties.AutomationId="HomeAnalyze" />
        </WrapPanel>
        <TextBlock Text="{Binding ScanState}" Style="{DynamicResource Caption}" VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite" />
      </DockPanel>

      <Border Style="{DynamicResource Panel}" Margin="0,0,0,14"
              Visibility="{Binding IsScanning, Converter={StaticResource BoolVisibility}}">
        <DockPanel>
          <Path Data="M9,2 A7,7 0 1 1 2,9" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                Width="18" Height="18" Stretch="None" Margin="0,0,14,0" VerticalAlignment="Center">
            <Path.RenderTransform><RotateTransform x:Name="ScanRotation" CenterX="9" CenterY="9" /></Path.RenderTransform>
          </Path>
          <StackPanel>
            <TextBlock Text="{Binding ScanProgressLabel}" Style="{DynamicResource Caption}" />
            <ProgressBar Value="{Binding CompletedCollectors, Mode=OneWay}" Maximum="{Binding TotalCollectors, Mode=OneWay}" Height="4" Margin="0,7,0,0" />
            <ItemsControl ItemsSource="{Binding ScanCollectors}" Margin="0,12,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,2"><TextBlock Text="{Binding State}" DockPanel.Dock="Right" Foreground="{DynamicResource SecondaryBrush}" /><TextBlock Text="{Binding Name}" /></DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DockPanel>
      </Border>

      <components:ResponsivePanel MinimumColumnWidth="410" Gap="14" Margin="0,0,0,21">
        <ui:Card Style="{StaticResource OverviewCard}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Shield24" Foreground="{DynamicResource AccentBrush}" FontSize="19" Margin="0,0,9,0" />
              <TextBlock Text="Saúde do sistema" Style="{DynamicResource SectionTitle}" />
            </StackPanel>
            <WrapPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,14,0,14">
              <Grid Width="120" Height="120" Margin="0,0,16,0">
                <components:CoverageRing Value="{Binding HealthCoveragePercent, Mode=OneWay}" Accent="{DynamicResource AccentBrush}"
                                         Track="{DynamicResource AccentMutedBrush}" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock Text="{Binding HealthCoverageShort}" FontSize="27" FontWeight="SemiBold"
                             HorizontalAlignment="Center" LineHeight="32" />
                  <TextBlock Text="Cobertura" Style="{DynamicResource Caption}" HorizontalAlignment="Center" />
                </StackPanel>
              </Grid>
              <StackPanel Width="210" MaxWidth="210" VerticalAlignment="Center">
                <TextBlock Text="{Binding HealthLabel}" FontSize="19" LineHeight="26" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LastScanLabel}" Style="{DynamicResource Caption}" Margin="0,7,0,0" />
                <TextBlock Text="{Binding HealthCoverage}" Style="{DynamicResource Caption}" Margin="0,4,0,0" />
              </StackPanel>
            </WrapPanel>
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
              <Button Command="{Binding OpenDiagnosticsCommand}" Content="Ver diagnóstico" Style="{DynamicResource QuietButton}" HorizontalAlignment="Left" />
            </Border>
          </Grid>
        </ui:Card>

        <ui:Card Style="{StaticResource OverviewCard}" DataContext="{Binding Dashboard}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel>
              <Border DockPanel.Dock="Right" Background="{DynamicResource SuccessMutedBrush}" CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
                <TextBlock Text="{Binding LiveStatus}" Foreground="{DynamicResource SuccessBrush}" FontSize="11" FontWeight="SemiBold" />
              </Border>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="DataUsage24" Foreground="{DynamicResource AccentBrush}" FontSize="19" Margin="0,0,9,0" />
                <TextBlock Text="Desempenho ao vivo" Style="{DynamicResource SectionTitle}" />
              </StackPanel>
            </DockPanel>
            <DockPanel Grid.Row="1" Margin="0,10,0,0">
              <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Metrics}" DisplayMemberPath="ShortName" SelectedItem="{Binding SelectedMetric}"
                        MinWidth="96" AutomationProperties.Name="Métrica do gráfico" />
              <TextBlock Text="{Binding SelectedMetric.ValueLabel}" FontSize="22" FontWeight="SemiBold" LineHeight="28" VerticalAlignment="Center" />
            </DockPanel>
            <components:TelemetryChart Grid.Row="2" Height="139" Margin="0,3,0,0"
                                       AutomationProperties.Name="Gráfico de uso nos últimos 60 segundos" />
            <DockPanel Grid.Row="3">
              <Button Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" Style="{DynamicResource QuietButton}" DockPanel.Dock="Right" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding SampleStatus}" Style="{DynamicResource Caption}" />
                <TextBlock Text="Histórico de até 60 segundos" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
              </StackPanel>
            </DockPanel>
          </Grid>
        </ui:Card>
      </components:ResponsivePanel>

      <DockPanel Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Content="Ver hardware" Command="{Binding OpenHardwareCommand}" Style="{DynamicResource QuietButton}" />
        <TextBlock Text="Uso de recursos" Style="{DynamicResource SectionTitle}" VerticalAlignment="Center" />
      </DockPanel>
      <views:LiveMetricsView DataContext="{Binding Dashboard}" />

      <components:ResponsivePanel MinimumColumnWidth="330" Gap="14" Margin="0,20,0,18">
        <Border Style="{DynamicResource Panel}" Padding="16">
          <StackPanel>
            <TextBlock Text="O que merece atenção" Style="{DynamicResource SectionTitle}" />
            <TextBlock Text="{Binding FindingsSummary}" Foreground="{DynamicResource WarningBrush}" Margin="0,7,0,8" />
            <ItemsControl ItemsSource="{Binding PriorityFindings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Entender os resultados" Command="{Binding OpenDiagnosticsCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Panel}" Padding="16">
          <StackPanel>
            <TextBlock Text="Ações rápidas" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8" />
            <Button Content="Revisar temporários" Command="{Binding OpenCleanupCommand}" Style="{DynamicResource ActionRow}" />
            <Button Content="Explorar armazenamento" Command="{Binding OpenStorageCommand}" Style="{DynamicResource ActionRow}" />
            <Button Content="Consultar histórico" Command="{Binding OpenHistoryCommand}" Style="{DynamicResource ActionRow}" />
          </StackPanel>
        </Border>
      </components:ResponsivePanel>

      <ItemsControl ItemsSource="{Binding DashboardWidgets}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><components:ResponsivePanel MinimumColumnWidth="197" Gap="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter"><Setter Property="Visibility" Value="{Binding Enabled, Converter={StaticResource BoolVisibility}}" /></Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{DynamicResource Notice}">
              <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{DynamicResource Eyebrow}" />
                <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,3" />
                <TextBlock Text="{Binding Detail}" Style="{DynamicResource Caption}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
