<UserControl x:Class="PHsystem.Desktop.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:components="clr-namespace:PHsystem.Desktop.Components"
             xmlns:views="clr-namespace:PHsystem.Desktop.Views">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility" /></UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,8,18">
      <Border Style="{DynamicResource HeroPanel}" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Width="84" Height="84" VerticalAlignment="Center" Margin="0,0,18,0">
            <components:CoverageRing Value="{Binding HealthCoveragePercent, Mode=OneWay}"
                                     Accent="{DynamicResource AccentBrush}" Track="{DynamicResource AccentMutedBrush}" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.Name="Cobertura das verificações">
              <TextBlock Text="{Binding HealthCoverageShort}" FontSize="19" FontWeight="SemiBold" TextAlignment="Center" />
              <TextBlock Text="Cobertura" Style="{DynamicResource Eyebrow}" />
            </StackPanel>
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Saúde do sistema" Style="{DynamicResource Caption}" />
            <TextBlock Text="{Binding HealthLabel}" FontSize="23" FontWeight="SemiBold" Margin="0,3,0,4" />
            <TextBlock Text="{Binding LastScanLabel, StringFormat={}Última análise · {0}}" Style="{DynamicResource Caption}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
            <Button Content="Analisar computador" Command="{Binding ScanCommand}" Style="{DynamicResource PrimaryButton}"
                    AutomationProperties.AutomationId="HomeAnalyze" />
            <Button Content="Ver diagnóstico" Command="{Binding OpenDiagnosticsCommand}" Style="{DynamicResource SubtleAction}" Margin="0,4,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{DynamicResource Panel}" Margin="0,0,0,16"
              Visibility="{Binding IsScanning, Converter={StaticResource BoolVisibility}}">
        <StackPanel>
          <DockPanel>
            <Path Data="M9,2 A7,7 0 1 1 2,9" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                  Width="18" Height="18" Stretch="None" Margin="0,0,12,0" VerticalAlignment="Center" DockPanel.Dock="Left">
              <Path.RenderTransform><RotateTransform x:Name="ScanRotation" CenterX="9" CenterY="9" /></Path.RenderTransform>
            </Path>
            <TextBlock Text="{Binding ScanProgressLabel}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
          </DockPanel>
          <ProgressBar Value="{Binding CompletedCollectors, Mode=OneWay}" Maximum="{Binding TotalCollectors, Mode=OneWay}"
                       Height="4" Margin="0,10,0,0" />
          <Expander Header="Ver etapas da análise" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding ScanCollectors}" Margin="0,4,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{DynamicResource DividerRow}" Padding="0,7">
                    <DockPanel>
                      <TextBlock Text="{Binding State}" DockPanel.Dock="Right" Style="{DynamicResource Caption}" Margin="10,0,0,0" />
                      <TextBlock Text="{Binding Name}" />
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
        </StackPanel>
      </Border>

      <Border Style="{DynamicResource Panel}" DataContext="{Binding Dashboard}" Margin="0,0,0,12">
        <StackPanel>
          <DockPanel>
            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Metrics}" DisplayMemberPath="ShortName" SelectedItem="{Binding SelectedMetric}"
                      MinWidth="104" AutomationProperties.Name="Métrica do gráfico" />
            <DockPanel VerticalAlignment="Center">
              <Border Style="{DynamicResource AccentIconTile}" DockPanel.Dock="Left" Margin="0,0,10,0">
                <ui:SymbolIcon Symbol="DataUsage24" FontSize="19" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel>
                <TextBlock Text="Uso em tempo real" Style="{DynamicResource SectionTitle}" />
                <TextBlock Text="{Binding LiveStatus}" Style="{DynamicResource Caption}" />
              </StackPanel>
            </DockPanel>
          </DockPanel>
          <DockPanel Margin="0,7,0,0">
            <TextBlock Text="Últimos 60 segundos" Style="{DynamicResource Caption}" DockPanel.Dock="Right" VerticalAlignment="Center" />
            <TextBlock Text="{Binding SelectedMetric.ValueLabel}" Style="{DynamicResource MetricNumber}" />
          </DockPanel>
          <components:TelemetryChart Height="146" Margin="0,0,0,6" AutomationProperties.Name="Uso da métrica nos últimos 60 segundos" />
          <DockPanel>
            <Button Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" Style="{DynamicResource SubtleAction}" DockPanel.Dock="Right" />
            <TextBlock Text="{Binding SampleStatus}" Style="{DynamicResource Caption}" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>
      </Border>
      <views:LiveMetricsView DataContext="{Binding Dashboard}" />

      <components:ResponsivePanel MinimumColumnWidth="320" Gap="12" Margin="0,16,0,12">
        <Border Style="{DynamicResource Panel}">
          <StackPanel>
            <TextBlock Text="Pontos de atenção" Style="{DynamicResource SectionTitle}" />
            <TextBlock Text="{Binding FindingsSummary}" Style="{DynamicResource Caption}" Margin="0,3,0,8" />
            <ItemsControl ItemsSource="{Binding PriorityFindings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{DynamicResource DividerRow}" Padding="0,8">
                    <TextBlock Text="{Binding Title}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Ver resultados" Command="{Binding OpenDiagnosticsCommand}" HorizontalAlignment="Left"
                    Style="{DynamicResource SubtleAction}" />
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Panel}">
          <StackPanel>
            <TextBlock Text="Ferramentas rápidas" Style="{DynamicResource SectionTitle}" Margin="0,0,0,10" />
            <Button Content="Revisar temporários" Command="{Binding OpenCleanupCommand}" Style="{DynamicResource ActionRow}" />
            <Button Content="Encontrar arquivos grandes" Command="{Binding OpenStorageCommand}" Style="{DynamicResource ActionRow}" />
            <Button Content="Ver análises salvas" Command="{Binding OpenHistoryCommand}" Style="{DynamicResource ActionRow}" Margin="0" />
          </StackPanel>
        </Border>
      </components:ResponsivePanel>

      <Expander Header="Dados da última análise">
        <ItemsControl ItemsSource="{Binding DashboardWidgets}" Margin="0,8,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><components:ResponsivePanel MinimumColumnWidth="192" Gap="12" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
              <Setter Property="Visibility" Value="{Binding Enabled, Converter={StaticResource BoolVisibility}}" />
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{DynamicResource Panel}" Padding="14">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" Style="{DynamicResource Caption}" />
                  <TextBlock Text="{Binding Value}" FontWeight="SemiBold" Margin="0,3,0,2" />
                  <TextBlock Text="{Binding Detail}" Style="{DynamicResource Caption}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
