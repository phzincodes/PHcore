<UserControl x:Class="PHsystem.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TabControl Margin="0,0,0,10">
    <TabItem Header="Análises salvas">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Style="{DynamicResource HeroPanel}" Margin="0,0,0,12">
          <DockPanel>
            <Button Content="Exportar análise atual" Command="{Binding ExportCommand}" DockPanel.Dock="Right" Margin="10,0,0,0" />
            <StackPanel>
              <TextBlock Text="{Binding HistoryCountLabel}" Style="{DynamicResource SectionTitle}" />
              <TextBlock Text="Últimas 20 análises deste perfil" Style="{DynamicResource Caption}" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{DynamicResource TablePanel}">
          <Grid>
            <DataGrid ItemsSource="{Binding History}" AutomationProperties.Name="Histórico de análises">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Quando" Binding="{Binding CapturedAt}" Width="1.25*" />
                <DataGridTextColumn Header="Cobertura da coleta" Binding="{Binding Coverage}" Width="1.75*" />
                <DataGridTextColumn Header="Referência" Binding="{Binding ShortId}" Width="1*" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="As análises concluídas aparecem aqui." VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
                  <Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Border>
        <Expander Grid.Row="2" Header="Gerenciar dados locais" Margin="0,8,0,0">
          <StackPanel Margin="0,6,0,0">
            <TextBlock Text="O banco local guarda até 100 análises. Arquivos exportados ficam no local escolhido." Style="{DynamicResource Caption}" />
            <Button Content="Apagar histórico local" Command="{Binding DeleteHistoryCommand}" Style="{DynamicResource DangerButton}"
                    HorizontalAlignment="Left" Margin="0,8,0,0" />
          </StackPanel>
        </Expander>
      </Grid>
    </TabItem>
    <TabItem Header="Comparar">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{DynamicResource Panel}" Margin="0,0,0,12">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Análise anterior" Style="{DynamicResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding History}" SelectedItem="{Binding CompareBefore}" DisplayMemberPath="CapturedAt" AutomationProperties.Name="Análise anterior" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="Análise posterior" Style="{DynamicResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding History}" SelectedItem="{Binding CompareAfter}" DisplayMemberPath="CapturedAt" AutomationProperties.Name="Análise posterior" />
              </StackPanel>
              <Button Grid.Column="2" Content="Comparar" Command="{Binding CompareHistoryCommand}" Style="{DynamicResource PrimaryButton}" VerticalAlignment="Bottom" />
            </Grid>
            <TextBlock Text="{Binding ComparisonStatus}" Style="{DynamicResource Caption}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Style="{DynamicResource TablePanel}">
          <DataGrid ItemsSource="{Binding HistoryDifferences}" AutomationProperties.Name="Diferenças entre as análises">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="*" />
              <DataGridTextColumn Header="Campo" Binding="{Binding Field}" Width="*" />
              <DataGridTextColumn Header="Antes" Binding="{Binding Before}" Width="*" />
              <DataGridTextColumn Header="Depois" Binding="{Binding After}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </Grid>
    </TabItem>
    <TabItem Header="Manutenção">
      <DockPanel>
        <TextBlock Text="Ferramentas do Windows abertas pelo PHsystem" Style="{DynamicResource SectionTitle}" DockPanel.Dock="Top" Margin="0,0,0,10" />
        <Border Style="{DynamicResource TablePanel}">
          <Grid>
            <DataGrid ItemsSource="{Binding MaintenanceHistory}" AutomationProperties.Name="Histórico de manutenção">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Data" Binding="{Binding When}" Width="1.2*" />
                <DataGridTextColumn Header="Ferramenta" Binding="{Binding Tool}" Width="1.8*" />
                <DataGridTextColumn Header="Resultado" Binding="{Binding Result}" Width="1.2*" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Nenhuma ferramenta aberta nesta instalação." VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
                  <Style.Triggers><DataTrigger Binding="{Binding MaintenanceHistory.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Border>
      </DockPanel>
    </TabItem>
  </TabControl>
</UserControl>
