<UserControl x:Class="PHsystem.Desktop.Views.PrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:PHsystem.Desktop.Components">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,8,18">
      <Border Style="{DynamicResource HeroPanel}" Margin="0,0,0,12">
        <DockPanel>
          <Border DockPanel.Dock="Left" Style="{DynamicResource AccentIconTile}" Margin="0,0,14,0">
            <components:IconControl Data="M6,10 L18,10 18,20 6,20 Z M8,10 L8,7 A4,4 0 0 1 16,7 L16,10 M12,14 L12,16"
                                    Stroke="{DynamicResource AccentBrush}" Width="22" Height="22" />
          </Border>
          <StackPanel>
            <TextBlock Text="Diagnósticos locais" Style="{DynamicResource SectionTitle}" />
            <TextBlock Text="As análises ficam no seu perfil do Windows. Compartilhar dados na comunidade é opcional." Style="{DynamicResource Caption}" Margin="0,4,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
      <components:ResponsivePanel MinimumColumnWidth="285" Gap="12" Margin="0,0,0,10">
        <Border Style="{DynamicResource Panel}">
          <StackPanel>
            <TextBlock Text="Seu histórico" Style="{DynamicResource SectionTitle}" />
            <TextBlock Text="Veja, compare ou apague as análises salvas neste computador." Style="{DynamicResource Caption}" Margin="0,5,0,10" />
            <Button Content="Abrir histórico" Command="{Binding OpenHistoryCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Panel}">
          <StackPanel>
            <TextBlock Text="Perfil público" Style="{DynamicResource SectionTitle}" />
            <TextBlock Text="Revise os dados que você autorizou publicar no seu perfil." Style="{DynamicResource Caption}" Margin="0,5,0,10" />
            <Button Content="Revisar compartilhamento" Command="{Binding OpenSharingCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </components:ResponsivePanel>
      <Border Style="{DynamicResource Panel}">
        <StackPanel>
          <TextBlock Text="Exportar dados" Style="{DynamicResource SectionTitle}" />
          <TextBlock Text="Revise o diagnóstico completo antes de compartilhar. O relatório reduzido resume a avaliação de saúde e omite detalhes de hardware e caminhos." Style="{DynamicResource Caption}" Margin="0,5,0,10" />
          <WrapPanel>
            <Button Content="Exportar diagnóstico completo" Command="{Binding ExportCommand}" Margin="0,0,8,6" />
            <Button Content="Exportar relatório reduzido" Command="{Binding ExportSafeReportCommand}" Margin="0,0,0,6" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Expander Header="Arquivos, permissões e conta" Margin="0,8,0,0">
        <Border Style="{DynamicResource Notice}" Margin="0,6,0,0">
          <StackPanel>
            <TextBlock Text="Histórico local · %LOCALAPPDATA%\PHsystemNext\snapshots.db" />
            <TextBlock Text="A proteção do banco depende das permissões do perfil do Windows. Mensagens da comunidade não têm criptografia de ponta a ponta." Style="{DynamicResource Caption}" Margin="0,5,0,0" />
            <TextBlock Text="A exploração mantém os caminhos de arquivos na memória. A limpeza consulta outras pastas temporárias em modo somente leitura. A exclusão só é oferecida para arquivos elegíveis da pasta temporária local do usuário." Style="{DynamicResource Caption}" Margin="0,5,0,0" />
          </StackPanel>
        </Border>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
