<UserControl x:Class="PHsystem.Desktop.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:PHsystem.Desktop.Components">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,8,18" MaxWidth="920" HorizontalAlignment="Left">
      <Border Style="{DynamicResource HeroPanel}" Margin="0,0,0,12">
        <DockPanel>
          <Border Style="{DynamicResource AccentIconTile}" DockPanel.Dock="Left" Margin="0,0,14,0">
            <components:IconControl Data="M5,7 L19,7 22,15 20,19 15,15 9,15 4,19 2,15 Z M5,11 L11,11 M8,8 L8,14 M15,11 L16,11 M18,13 L19,13"
                                    Stroke="{DynamicResource AccentBrush}" Width="22" Height="22" />
          </Border>
          <StackPanel>
            <TextBlock AutomationProperties.LiveSetting="Polite">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="Perfil de jogo inativo" />
                  <Setter Property="FontSize" Value="17" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsGameProfileActive}" Value="True">
                      <Setter Property="Text" Value="Perfil de jogo ativo" />
                      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding GameStatus}" Style="{DynamicResource Caption}" Margin="0,4,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{DynamicResource Panel}">
        <StackPanel>
          <TextBlock Text="Processo do jogo" Style="{DynamicResource FieldLabel}" />
          <DockPanel>
            <Button Content="Atualizar lista" Command="{Binding RefreshProcessesCommand}" DockPanel.Dock="Right" Margin="8,0,0,0" />
            <ComboBox ItemsSource="{Binding GameProcesses}" SelectedItem="{Binding SelectedProcess}" DisplayMemberPath="Name"
                      MinWidth="240" AutomationProperties.Name="Processo do jogo" />
          </DockPanel>
          <WrapPanel Margin="0,12,0,0">
            <Button Content="Ativar perfil por até 30 min" Command="{Binding StartGameCommand}" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0" />
            <Button Content="Encerrar e restaurar" Command="{Binding StopGameCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Expander Header="Prioridade e restauração" Margin="0,8,0,0">
        <TextBlock Text="O perfil aplica a prioridade Acima do normal ao processo escolhido. A prioridade anterior volta ao encerrar o perfil ou fechar normalmente o PHsystem. Se o aplicativo for encerrado à força, confira a prioridade no Gerenciador de Tarefas." Style="{DynamicResource Caption}" Margin="0,6,0,0" />
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
