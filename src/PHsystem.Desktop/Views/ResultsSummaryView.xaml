<UserControl x:Class="PHsystem.Desktop.Views.ResultsSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,8,18">
      <Border Style="{DynamicResource HeroPanel}" Margin="0,0,0,16">
        <DockPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="14,0,0,0">
            <Button Content="Exportar diagnóstico" Command="{Binding ExportCommand}" VerticalAlignment="Center"
                    ToolTip="O arquivo completo pode conter dados privados do computador." />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{Binding HealthLabel}" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="{Binding CollectionSummary}" Style="{DynamicResource Caption}" Margin="0,5,0,0" />
            <TextBlock Text="{Binding LastScanLabel, StringFormat={}Última análise · {0}}" Style="{DynamicResource Caption}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <TextBlock Text="O que revisar" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8" />
      <Border Style="{DynamicResource Panel}">
        <StackPanel>
          <TextBlock Text="{Binding FindingsSummary}" Style="{DynamicResource Caption}" />
          <ItemsControl ItemsSource="{Binding Findings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{DynamicResource DividerRow}" Margin="0,12,0,0">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                    <TextBlock Text="{Binding PossibleAction}" Margin="0,4,0,0" />
                    <Expander Header="Evidência e impacto" Margin="0,4,0,0">
                      <StackPanel Margin="0,7,0,0">
                        <TextBlock Text="{Binding Description}" />
                        <TextBlock Text="{Binding Evidence}" Style="{DynamicResource Caption}" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding Impact}" Style="{DynamicResource Caption}" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding Risk}" Foreground="{DynamicResource WarningBrush}" Margin="0,5,0,0" />
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
