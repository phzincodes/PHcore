<UserControl x:Class="PHsystem.Desktop.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PHsystem.Desktop.Views"
             xmlns:components="clr-namespace:PHsystem.Desktop.Components">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,8,18">
      <components:ResponsivePanel MinimumColumnWidth="285" Gap="12" Margin="0,0,0,15">
        <Border Style="{DynamicResource HeroPanel}">
          <StackPanel>
            <TextBlock Text="Processador" Style="{DynamicResource Caption}" />
            <TextBlock Text="{Binding CpuModel}" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,4" />
            <TextBlock Text="{Binding CpuDetail}" Style="{DynamicResource Caption}" />
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource Panel}">
          <StackPanel>
            <TextBlock Text="Memória instalada" Style="{DynamicResource Caption}" />
            <TextBlock Text="{Binding MemoryTotal}" Style="{DynamicResource MetricNumber}" Margin="0,3" />
            <TextBlock Text="{Binding MemoryDetail}" Style="{DynamicResource Caption}" />
          </StackPanel>
        </Border>
      </components:ResponsivePanel>
      <DockPanel Margin="0,0,0,8">
        <Button Content="{Binding Dashboard.ToggleLabel}" Command="{Binding Dashboard.ToggleCommand}" Style="{DynamicResource SubtleAction}" DockPanel.Dock="Right" />
        <TextBlock Text="Uso em tempo real" Style="{DynamicResource SectionTitle}" VerticalAlignment="Center" />
      </DockPanel>
      <views:LiveMetricsView DataContext="{Binding Dashboard}" />
      <DockPanel Margin="0,17,0,8">
        <TextBlock Text="{Binding LastScanLabel}" Style="{DynamicResource Caption}" DockPanel.Dock="Right" VerticalAlignment="Center" />
        <TextBlock Text="Componentes instalados" Style="{DynamicResource SectionTitle}" />
      </DockPanel>
      <components:CategoryResults DataContext="{Binding HardwareCategories}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
