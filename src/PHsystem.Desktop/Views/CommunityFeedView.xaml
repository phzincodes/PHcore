<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PHsystem.Desktop" xmlns:views="clr-namespace:PHsystem.Desktop.Views" xmlns:components="clr-namespace:PHsystem.Desktop.Components" x:Class="PHsystem.Desktop.Views.CommunityFeedView" Loaded="FeedLoaded">
  <UserControl.Resources>
    <local:ReviewLabelConverter x:Key="ReviewLabel"/>
    <local:ReplyIndentConverter x:Key="ReplyIndent"/>
    <local:NotificationLabelConverter x:Key="NotificationLabel"/>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TabControl Grid.Row="0" SelectedIndex="{Binding FeedTabIndex, Mode=TwoWay}" IsEnabled="{Binding IsReady}">
      <TabItem Header="Feed">
        <Grid Margin="0,0,6,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Style="{DynamicResource HeroPanel}" Margin="0,0,0,9" Padding="13">
            <StackPanel>
              <DockPanel>
                <Button Content="Criar publicação" Command="{Binding NewPostCommand}" DockPanel.Dock="Right" Style="{DynamicResource PrimaryButton}" Margin="7,0,0,0"/>
                <Button Content="Buscar" Command="{Binding LoadFeedCommand}" DockPanel.Dock="Right" Margin="7,0,0,0"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Pesquisar publicações" ToolTip="Digite o assunto e clique em Buscar."/>
              </DockPanel>
              <DockPanel Margin="0,7,0,0">
                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding FeedSorts}" SelectedItem="{Binding SelectedFeedSort}" DisplayMemberPath="Label" MinWidth="120" AutomationProperties.Name="Ordenação das publicações"/>
                <Expander Header="Filtros e categorias" Margin="0,0,10,0">
                  <StackPanel Margin="0,6,0,0">
                    <components:ResponsivePanel MinimumColumnWidth="150" Gap="8">
                      <StackPanel>
                        <TextBlock Text="Tipo" Style="{DynamicResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding PostKinds}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding FeedKind}" AutomationProperties.Name="Tipo de publicação para filtrar"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="Categoria" Style="{DynamicResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding FeedCategory}" AutomationProperties.Name="Categoria das publicações"/>
                      </StackPanel>
                    </components:ResponsivePanel>
                    <WrapPanel Margin="0,7,0,7">
                      <CheckBox Content="Com solução" IsChecked="{Binding OnlySolved}" Margin="0,0,10,0"/>
                      <CheckBox Content="Sem resposta" IsChecked="{Binding OnlyUnanswered}"/>
                    </WrapPanel>
                    <WrapPanel>
                      <Button Content="Aplicar filtros" Command="{Binding LoadFeedCommand}" Margin="0,0,6,4"/>
                      <Button Content="Todas as categorias" Command="{Binding ClearCategoryCommand}" Style="{DynamicResource SubtleAction}" Margin="0,0,6,4"/>
                      <Button Content="Seguir categoria" Command="{Binding FollowCategoryCommand}" Style="{DynamicResource SubtleAction}" Margin="0,0,6,4"/>
                      <Button Content="Deixar de seguir" Command="{Binding UnfollowCategoryCommand}" Style="{DynamicResource SubtleAction}" Margin="0,0,6,4"/>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding FollowedCategories}" AutomationProperties.Name="Categorias seguidas"/>
                  </StackPanel>
                </Expander>
              </DockPanel>
            </StackPanel>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,7,12">
              <TextBlock Text="{Binding FeedStatus}" Style="{DynamicResource Caption}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
              <ItemsControl ItemsSource="{Binding Posts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <components:PostCard UpvoteCommand="{Binding DataContext.UpvoteCommand, RelativeSource={RelativeSource AncestorType=views:CommunityFeedView}}" DownvoteCommand="{Binding DataContext.DownvoteCommand, RelativeSource={RelativeSource AncestorType=views:CommunityFeedView}}" SaveCommand="{Binding DataContext.ToggleSaveCommand, RelativeSource={RelativeSource AncestorType=views:CommunityFeedView}}" OpenCommand="{Binding DataContext.OpenPostCommand, RelativeSource={RelativeSource AncestorType=views:CommunityFeedView}}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Carregar mais" Command="{Binding MoreFeedCommand}" IsEnabled="{Binding HasMore}" HorizontalAlignment="Center" Visibility="{Binding HasMore, Converter={StaticResource BoolVisibility}}" Margin="0,4,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Publicação">
        <Grid>
          <TextBlock Text="Abra uma publicação no feed para ler o conteúdo e as respostas." VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedPost}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
              <Style TargetType="ScrollViewer">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedPost}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="0,0,8,14">
              <Border Style="{DynamicResource HeroPanel}" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Text="{Binding SelectedPost.Title}" Style="{DynamicResource SectionTitle}"/>
                  <TextBlock Text="{Binding SelectedPost.Author}" Style="{DynamicResource Caption}" Margin="0,8,0,0"/>
                  <TextBlock Text="{Binding SelectedPost.Body}" Margin="0,18,0,20"/>
                  <Button Command="{Binding FollowSelectedPostCommand}" HorizontalAlignment="Left" Margin="0" Style="{DynamicResource CompactAction}">
                    <TextBlock>
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="Seguir publicação"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedPost.Followed}" Value="True">
                              <Setter Property="Text" Value="Parar de seguir"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Button>
                </StackPanel>
              </Border>
              <DockPanel Margin="0,0,0,7">
                <Button Content="Atualizar respostas" Command="{Binding LoadRepliesCommand}" HorizontalAlignment="Left" DockPanel.Dock="Right" Style="{DynamicResource CompactAction}"/>
                <TextBlock Text="Respostas" Style="{DynamicResource SectionTitle}" VerticalAlignment="Center"/>
              </DockPanel>
              <ListBox ItemsSource="{Binding Replies}" SelectedItem="{Binding SelectedReply}" MaxHeight="400" Margin="0,0,0,8" AutomationProperties.Name="Respostas da publicação">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="{Binding Depth, Converter={StaticResource ReplyIndent}}">
                      <TextBlock Text="{Binding Author}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Body}" Margin="0,8,0,8"/>
                      <TextBlock Text="Solução aceita pelo autor" Foreground="{DynamicResource AccentBrush}" FontSize="11" Visibility="{Binding Accepted, Converter={StaticResource BoolVisibility}}"/>
                      <TextBlock Text="{Binding ReviewState, Converter={StaticResource ReviewLabel}}" Foreground="{DynamicResource WarningBrush}" FontSize="11"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Content="Marcar resposta como solução" Command="{Binding AcceptSolutionCommand}" HorizontalAlignment="Left" Margin="0,12,0,18" Style="{DynamicResource SubtleAction}"/>
              <Border Style="{DynamicResource Panel}" Margin="0,8,0,8">
                <StackPanel>
                  <TextBlock Text="Escrever resposta" Style="{DynamicResource SectionTitle}" Margin="0,0,0,5"/>
                  <WrapPanel Margin="0,0,0,10">
                    <Button Content="Responder à resposta selecionada" Command="{Binding ReplyToSelectedCommand}" Style="{DynamicResource QuietButton}"/>
                    <Button Content="Responder à publicação" Command="{Binding ReplyToPostCommand}" Style="{DynamicResource QuietButton}"/>
                  </WrapPanel>
                  <TextBlock Text="{Binding ReplyContext}" Style="{DynamicResource Caption}"/>
                  <TextBox Text="{Binding ReplyBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="68" MaxLength="8000" TextWrapping="Wrap" AutomationProperties.Name="Texto da resposta"/>
                  <Button Content="Enviar resposta" Command="{Binding ReplyCommand}" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>
              </Border>
              <Expander Header="Denunciar">
                <StackPanel Margin="0,10,0,0">
                  <TextBox Text="{Binding ReportReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000"/>
                  <Button Content="Enviar denúncia" Command="{Binding ReportCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>
              </Expander>
              <Expander Header="Gerenciar minha publicação">
                <StackPanel Margin="0,10,0,0">
                  <Button Content="Editar minha publicação" Command="{Binding EditSelectedCommand}" HorizontalAlignment="Left"/>
                  <CheckBox Content="Confirmo a remoção da minha publicação" IsChecked="{Binding DeletePostConsent}"/>
                  <Button Content="Remover publicação" Command="{Binding DeleteSelectedCommand}" Style="{DynamicResource DangerButton}" HorizontalAlignment="Left"/>
                </StackPanel>
              </Expander>
              <Expander Header="Editar ou remover uma resposta sua">
                <StackPanel>
                  <Button Content="Editar resposta selecionada" Command="{Binding BeginReplyEditCommand}" IsEnabled="{Binding SelectedReply.IsOwner}" HorizontalAlignment="Left"/>
                  <TextBox Text="{Binding ReplyEditBody}" AcceptsReturn="True" MinHeight="100" MaxLength="8000" Margin="0,12"/>
                  <Button Content="Salvar edição" Command="{Binding SaveReplyEditCommand}" IsEnabled="{Binding SelectedReply.IsOwner}" HorizontalAlignment="Left"/>
                  <CheckBox Content="Confirmo a remoção da minha resposta selecionada" IsChecked="{Binding ReplyDeleteConsent}"/>
                  <Button Content="Remover resposta" Command="{Binding RemoveReplyCommand}" IsEnabled="{Binding SelectedReply.IsOwner}" Style="{DynamicResource DangerButton}" HorizontalAlignment="Left"/>
                  <TextBlock Text="Editar retira a revisão técnica e a solução aceita, quando aplicável. Versões anteriores ficam no histórico privado." Style="{DynamicResource Caption}" Margin="0,12,0,0"/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Editor">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Border Style="{DynamicResource Panel}" MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,8,12">
            <StackPanel>
              <TextBlock Text="Editar publicação" Style="{DynamicResource SectionTitle}"/>
              <TextBlock Text="Remova dados pessoais e logs brutos antes de publicar." Style="{DynamicResource Caption}" Margin="0,8,0,20"/>
              <TextBlock Text="Título" Style="{DynamicResource FieldLabel}"/>
              <TextBox Text="{Binding PostTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="160"/>
              <components:ResponsivePanel MinimumColumnWidth="155" Gap="10" Margin="0,10,0,0">
                <StackPanel>
                  <TextBlock Text="Tipo de publicação" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5"/>
                  <ComboBox ItemsSource="{Binding PostKinds}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding PostKind}" AutomationProperties.Name="Tipo de publicação"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Categoria" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5"/>
                  <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding PostCategory}" AutomationProperties.Name="Categoria da publicação"/>
                </StackPanel>
              </components:ResponsivePanel>
              <TextBlock Text="Descrição" Style="{DynamicResource FieldLabel}" Margin="0,16,0,6"/>
              <TextBox Text="{Binding PostBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" MaxLength="8000"/>
              <Expander Header="Rascunho e prévia">
                <StackPanel>
                  <WrapPanel Margin="0,6,0,0">
                    <Button Content="Salvar rascunho" Command="{Binding SaveDraftCommand}"/>
                    <Button Content="Abrir rascunho" Command="{Binding LoadDraftCommand}" Margin="8,0"/>
                    <Button Content="Pré-visualizar texto" Command="{Binding PreviewPostCommand}"/>
                  </WrapPanel>
                  <TextBlock Text="{Binding PostPreview}"/>
                </StackPanel>
              </Expander>
              <Button Content="Salvar publicação" Command="{Binding SavePostCommand}" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Perfis">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="700" HorizontalAlignment="Left" Margin="0,0,8,12">
            <TextBlock Text="Usuário para consultar" Style="{DynamicResource FieldLabel}"/>
            <DockPanel Margin="0">
              <Button Content="Ver perfil público" Command="{Binding LoadProfileCommand}" DockPanel.Dock="Right" Margin="12,0,0,0"/>
              <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" MinWidth="260" AutomationProperties.Name="Nome para consultar perfil público"/>
            </DockPanel>
            <Border Margin="0,8,0,0">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                  <Setter Property="CornerRadius" Value="{DynamicResource PanelRadius}"/>
                  <Setter Property="Padding" Value="15"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Profile}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel>
                <TextBlock Text="{Binding Profile.Username}" Style="{DynamicResource SectionTitle}"/>
                <TextBlock Text="{Binding Profile.Bio}" Margin="0,12,0,16"/>
                <TextBlock Text="{Binding Profile.Posts, StringFormat={}Publicações: {0}}"/>
                <TextBlock Text="{Binding Profile.Replies, StringFormat={}Respostas: {0}}"/>
                <TextBlock Text="{Binding Profile.AcceptedSolutions, StringFormat={}Soluções aceitas: {0}}"/>
                <ItemsControl ItemsSource="{Binding Profile.Hardware}" Margin="0,14,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Key}" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Value}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Expander Header="Editar minha descrição pública">
              <StackPanel Margin="0,12,0,0">
                <TextBox Text="{Binding ProfileBio, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AcceptsReturn="True" MinHeight="80"/>
                <Button Content="Salvar descrição" Command="{Binding SaveProfileCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
              </StackPanel>
            </Expander>
            <Expander Header="Visibilidade e saúde compartilhada" Margin="0,4,0,0">
              <Border Style="{DynamicResource Panel}" Margin="0,6,0,7">
                <StackPanel>
                  <Button Content="Carregar minhas preferências" Command="{Binding LoadOwnProfileSettingsCommand}" HorizontalAlignment="Left" Margin="0,12"/>
                  <CheckBox Content="Permitir visitantes verem meu perfil e o hardware que compartilhei" IsChecked="{Binding PublicProfileEnabled}"/>
                  <Button Content="Salvar visibilidade" Command="{Binding SavePublicSettingsCommand}" HorizontalAlignment="Left" Margin="0,12"/>
                  <Expander Header="Cor de destaque do perfil (#RRGGBB)" Margin="0,4,0,0">
                    <TextBox Text="{Binding ProfileAccent}" AutomationProperties.Name="Cor do perfil em hexadecimal" Margin="0,5,0,0"/>
                  </Expander>
                  <Button Content="Ver como visitante" Command="{Binding PreviewVisitorProfileCommand}" HorizontalAlignment="Left"/>
                  <TextBlock Text="{Binding Profile.Reputation, StringFormat={}Reputação por contribuições: {0}}" Margin="0,14,0,0"/>
                  <Expander Header="O que compartilhar sobre saúde" Margin="0,7,0,0">
                    <StackPanel Margin="0,5,0,0">
                      <TextBlock Text="{Binding ProfileHealthLabel}" Margin="0,8"/>
                      <ComboBox ItemsSource="{Binding HealthSharingModes}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding HealthSharingMode}"/>
                      <CheckBox Content="Participar do ranking autodeclarado (somente nota completa)" IsChecked="{Binding HealthRankingConsent}"/>
                      <Button Content="Confirmar preferência de saúde" Command="{Binding ShareHealthCommand}" HorizontalAlignment="Left" Margin="0,12"/>
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Notificações">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,16">
            <Button Content="Atualizar notificações" Command="{Binding LoadNotificationsCommand}" DockPanel.Dock="Right" Style="{DynamicResource CompactAction}"/>
            <TextBlock Text="{Binding NotificationSummary}" Style="{DynamicResource Caption}" VerticalAlignment="Center"/>
          </DockPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding Notifications}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <Button Content="Marcar como lida" DockPanel.Dock="Right" Command="{Binding DataContext.ReadNotificationCommand, RelativeSource={RelativeSource AncestorType=views:CommunityFeedView}}" CommandParameter="{Binding}" Margin="18,0,0,0"/>
                  <StackPanel>
                    <TextBlock Text="{Binding Kind, Converter={StaticResource NotificationLabel}}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd/MM HH:mm}}" Style="{DynamicResource Caption}"/>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="1" Text="{Binding Status}" Style="{DynamicResource Caption}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
</UserControl>
