<UserControl x:Class="PHsystem.Desktop.Views.CommunityShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PHsystem.Desktop.Views"
             xmlns:components="clr-namespace:PHsystem.Desktop.Components">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="SessionVisibility" /></UserControl.Resources>
  <Grid>
    <Border Style="{DynamicResource HeroPanel}" MaxWidth="520"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
            Visibility="{Binding IsOfflineUser, Converter={StaticResource SessionVisibility}}">
      <StackPanel>
        <Border Style="{DynamicResource AccentIconTile}" HorizontalAlignment="Left" Margin="0,0,0,12">
          <components:IconControl Data="M4,5 H20 V16 H10 L5,20 V16 H4 Z M8,9 H16 M8,12 H13"
                                  Stroke="{DynamicResource AccentBrush}" Width="22" Height="22" />
        </Border>
        <TextBlock Text="Entre para acessar as conversas" Style="{DynamicResource SectionTitle}" />
        <TextBlock Text="Publique dúvidas, acompanhe respostas e gerencie seu perfil." Style="{DynamicResource Caption}" Margin="0,5,0,12" />
        <Button Content="Entrar ou criar conta" Command="{Binding OpenAccountCommand}" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>
    <TabControl Visibility="{Binding IsAuthenticated, Converter={StaticResource SessionVisibility}}" SelectedIndex="{Binding SocialTabIndex, Mode=TwoWay}">
      <TabItem Header="Publicações"><views:CommunityFeedView DataContext="{Binding Community}" /></TabItem>
      <TabItem Header="Conta e mensagens"><views:CommunityView /></TabItem>
    </TabControl>
  </Grid>
</UserControl>
