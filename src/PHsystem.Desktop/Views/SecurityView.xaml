<UserControl x:Class="PHsystem.Desktop.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:PHsystem.Desktop.Components">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,8,18">
      <Border Style="{DynamicResource HeroPanel}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Proteção do computador" Style="{DynamicResource SectionTitle}" />
          <TextBlock Text="{Binding LastScanLabel, StringFormat={}Última verificação · {0}}" Style="{DynamicResource Caption}" Margin="0,4,0,12" />
          <WrapPanel>
            <Button Content="Abrir Segurança do Windows" Command="{Binding OpenWindowsSecurityCommand}" Margin="0,0,8,6" />
            <Button Content="Abrir Windows Update" Command="{Binding OpenWindowsUpdateCommand}" Margin="0,0,0,6" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <TextBlock Text="Resultados de proteção e integridade" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8" />
      <components:CategoryResults DataContext="{Binding SecurityCategories}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
