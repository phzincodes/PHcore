<UserControl x:Class="PHsystem.Desktop.Views.RecommendationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility" /></UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,8,18">
      <Border Style="{DynamicResource HeroPanel}" Margin="0,0,0,12">
        <DockPanel>
          <Button Content="Atualizar análise" Command="{Binding ScanCommand}" DockPanel.Dock="Right" Margin="12,0,0,0" />
          <StackPanel>
            <TextBlock Text="Orientações para este computador" Style="{DynamicResource SectionTitle}" />
            <TextBlock Text="{Binding LastScanLabel, StringFormat={}Baseado na última análise · {0}}" Style="{DynamicResource Caption}" Margin="0,4,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{DynamicResource Notice}" Margin="0,0,0,12" Visibility="{Binding HasExpiredEvidence, Converter={StaticResource BoolVisibility}}">
        <StackPanel>
          <TextBlock Text="{Binding ExpiredEvidenceLabel}" Foreground="{DynamicResource WarningBrush}" />
          <Expander Header="Ver categorias desatualizadas" Margin="0,4,0,0">
            <ItemsControl ItemsSource="{Binding RefreshRecommendations}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Title}" Style="{DynamicResource Caption}" Margin="0,0,0,4" /></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
        </StackPanel>
      </Border>
      <Border Padding="14" Background="{DynamicResource InsetBrush}" CornerRadius="{DynamicResource PanelRadius}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding CurrentRecommendations.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="Sem orientações com as leituras disponíveis." Style="{DynamicResource Caption}" />
      </Border>
      <ItemsControl ItemsSource="{Binding CurrentRecommendations}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{DynamicResource Panel}" Margin="0,0,0,9">
              <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionTitle}" />
                <TextBlock Text="{Binding Detail}" Margin="0,5,0,5" />
                <Expander Header="Evidência, cuidados e fonte">
                  <StackPanel Margin="0,7,0,0">
                    <TextBlock Text="{Binding Evidence}" />
                    <TextBlock Text="{Binding Risk}" Foreground="{DynamicResource WarningBrush}" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding Source}" Style="{DynamicResource Caption}" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding ReviewedOn, StringFormat={}Referência revisada em {0}}" Style="{DynamicResource Caption}" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
