<UserControl x:Class="PHsystem.Desktop.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,0,0,10">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Style="{DynamicResource HeroPanel}" Margin="0,0,0,12">
      <DockPanel>
        <Button Content="Atualizar inventário" Command="{Binding ScanCommand}" Style="{DynamicResource PrimaryButton}"
                DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0" />
        <StackPanel>
          <TextBlock Text="Drivers de vídeo e rede instalados" Style="{DynamicResource SectionTitle}" />
          <TextBlock Text="{Binding DriverCountLabel}" Style="{DynamicResource Caption}" Margin="0,4,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Style="{DynamicResource TablePanel}">
      <Grid>
        <DataGrid ItemsSource="{Binding Drivers}" AutomationProperties.Name="Drivers instalados">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Dispositivo" Binding="{Binding Name}" Width="1.15*" />
            <DataGridTextColumn Header="Fornecedor e versão" Binding="{Binding VersionAndProvider}" Width="1*" />
          </DataGrid.Columns>
        </DataGrid>
        <Border Margin="0,35,0,0" Background="{DynamicResource PanelBrush}">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Drivers.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="Nenhum driver registrado. Atualize o inventário para consultar este computador."
                     Style="{DynamicResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Grid>
    </Border>
    <Expander Grid.Row="2" Header="O que o inventário consulta" Margin="0,8,0,0">
      <TextBlock Text="A lista mostra as versões registradas pelo Windows. A busca de atualizações e a instalação de drivers estão fora desta consulta." Style="{DynamicResource Caption}" Margin="0,6,0,3" />
    </Expander>
  </Grid>
</UserControl>
