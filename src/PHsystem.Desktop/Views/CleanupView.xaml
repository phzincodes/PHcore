<UserControl x:Class="PHsystem.Desktop.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PHsystem.Desktop">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <local:ByteSizeConverter x:Key="BytesLabel" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,8,18">
      <Border Style="{DynamicResource HeroPanel}" Margin="0,0,12,0">
        <DockPanel>
          <Button Content="Analisar temporários" Command="{Binding PreviewCleanupCommand}" Style="{DynamicResource PrimaryButton}"
                  DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0" />
          <StackPanel>
            <TextBlock Text="{Binding CleanupStateLabel}" Style="{DynamicResource SectionTitle}" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasCleanupFiles, Converter={StaticResource BoolVisibility}}">
              <TextBlock Text="{Binding CleanupSize}" Style="{DynamicResource MetricNumber}" Margin="0,0,10,0" />
              <TextBlock Text="{Binding CleanupCount}" Style="{DynamicResource Caption}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding CleanupEmptyMessage}" Style="{DynamicResource Caption}" Margin="0,4,0,0"
                       Visibility="{Binding ShowCleanupEmpty, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="CleanupEmptyMessage" />
          </StackPanel>
        </DockPanel>
      </Border>
      <StackPanel Visibility="{Binding CanReviewCleanup, Converter={StaticResource BoolVisibility}}" Margin="0,5,8,0">
        <DockPanel Margin="0,0,0,8">
          <TextBlock Text="{Binding CleanupSelectionLabel}" Style="{DynamicResource Caption}" DockPanel.Dock="Right" VerticalAlignment="Center" />
          <TextBlock Text="Revisar arquivos" Style="{DynamicResource SectionTitle}" />
        </DockPanel>
        <Border Style="{DynamicResource TablePanel}">
          <DataGrid ItemsSource="{Binding CleanupFiles}" MaxHeight="300" AutomationProperties.Name="Arquivos elegíveis para revisão">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Selecionar" Width="88">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                              AutomationProperties.Name="{Binding Name, StringFormat={}Selecionar {0}}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Arquivo" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="Tamanho" Binding="{Binding Bytes, Converter={StaticResource BytesLabel}}" Width="110" />
              <DataGridTextColumn Header="Alteração (UTC)" Binding="{Binding LastWriteUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="155" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>
        <Border Style="{DynamicResource Notice}" BorderBrush="{DynamicResource WarningBrush}" Margin="0,10,0,0">
          <StackPanel>
            <CheckBox Content="Revisei a seleção e autorizo a exclusão permanente." IsChecked="{Binding CleanupConsent}" />
            <TextBlock Text="Os arquivos excluídos não passam pela lixeira. A prévia vence em 10 minutos." Style="{DynamicResource Caption}" Margin="0,4,0,10" />
            <Button Content="Excluir arquivos selecionados" Command="{Binding CleanupCommand}" Style="{DynamicResource DangerButton}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel Visibility="{Binding HasCleanupResults, Converter={StaticResource BoolVisibility}}" Margin="0,5,8,0">
        <TextBlock Text="Resultado por arquivo" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8" />
        <Border Style="{DynamicResource TablePanel}">
          <DataGrid ItemsSource="{Binding CleanupResults}" MaxHeight="260" AutomationProperties.Name="Resultado da exclusão">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Arquivo" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="Resultado" Binding="{Binding Explanation}" Width="2*" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </StackPanel>
      <TextBlock Text="{Binding CleanupStatus}" Style="{DynamicResource Caption}" Margin="0,10,8,0"
                 AutomationProperties.AutomationId="CleanupStatus" AutomationProperties.LiveSetting="Polite" />
      <Expander Header="Pastas consultadas e critérios" Margin="0,8,8,0">
        <Border Style="{DynamicResource Panel}" Margin="0,6,0,0">
          <StackPanel>
            <TextBlock Text="Arquivos elegíveis" Style="{DynamicResource SectionTitle}" />
            <TextBlock Text="Arquivos com mais de 7 dias no primeiro nível da pasta temporária local do usuário. A prévia examina até 10.000 entradas e preserva arquivos em uso, alterados ou inseguros." Style="{DynamicResource Caption}" Margin="0,4,0,7" />
            <TextBlock Text="{Binding CleanupRoot}" Style="{DynamicResource Caption}" Margin="0,0,0,5" />
            <ItemsControl ItemsSource="{Binding CleanupAnalysisLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{DynamicResource DividerRow}" Padding="0,7">
                    <DockPanel>
                      <TextBlock Text="{Binding Name}" DockPanel.Dock="Left" Margin="0,0,12,0" />
                      <TextBlock Text="{Binding Value}" Style="{DynamicResource Caption}" />
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Outras pastas consultadas" Style="{DynamicResource SectionTitle}" Margin="0,12,0,3" />
            <TextBlock Text="Inventário somente leitura de até 2.000 entradas por pasta, sem subpastas." Style="{DynamicResource Caption}" Margin="0,0,0,5" />
            <ItemsControl ItemsSource="{Binding TempLocationLines}" AutomationProperties.Name="Outras pastas temporárias">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{DynamicResource DividerRow}" Padding="0,7">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Value}" Style="{DynamicResource Caption}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
