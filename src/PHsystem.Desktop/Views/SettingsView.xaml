<UserControl x:Class="PHsystem.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PHsystem.Desktop.Views"
             xmlns:components="clr-namespace:PHsystem.Desktop.Components">
  <TabControl>
    <TabItem Header="Aparência">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel DataContext="{Binding Preferences}" Margin="0,0,8,18">
          <components:ResponsivePanel MinimumColumnWidth="265" Gap="12" Margin="0,0,0,12">
            <Border Style="{DynamicResource HeroPanel}">
              <StackPanel>
                <TextBlock Text="Tema" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8" />
                <ComboBox ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding ThemeName}" AutomationProperties.Name="Tema do aplicativo" />
                <TextBlock Text="Cor de destaque" Style="{DynamicResource FieldLabel}" Margin="0,13,0,5" />
                <ItemsControl ItemsSource="{Binding AccentOptions}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Width="37" Height="34" Padding="5" Margin="0,0,5,5" Style="{DynamicResource CompactAction}"
                              Command="{Binding DataContext.Preferences.ApplyAccentCommand, RelativeSource={RelativeSource AncestorType=views:SettingsView}}"
                              CommandParameter="{Binding Color}" ToolTip="{Binding Label}"
                              AutomationProperties.Name="{Binding Label, StringFormat={}Cor de destaque {0}}">
                        <Border Width="16" Height="16" CornerRadius="8" Background="{Binding Color}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Style="{DynamicResource Panel}">
              <StackPanel>
                <TextBlock Text="Prévia da aparência" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8" />
                <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource ControlRadius}" Padding="11">
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Width="20" Background="{DynamicResource SidebarBrush}" CornerRadius="3" Margin="0,0,10,0" />
                    <StackPanel>
                      <TextBlock Text="Cor, texto e superfícies" FontWeight="SemiBold" Margin="0,0,0,5" />
                      <Border Background="{DynamicResource AccentBrush}" CornerRadius="{DynamicResource ControlRadius}" Padding="9,4" HorizontalAlignment="Left">
                        <TextBlock Text="Ação principal" Foreground="{DynamicResource ActionTextBrush}" FontWeight="SemiBold" FontSize="12" />
                      </Border>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>
          </components:ResponsivePanel>

          <Border Style="{DynamicResource Panel}" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="Leitura e espaçamento" Style="{DynamicResource SectionTitle}" Margin="0,0,0,10" />
              <components:ResponsivePanel MinimumColumnWidth="220" Gap="14">
                <StackPanel>
                  <TextBlock Text="Tamanho do texto" Style="{DynamicResource FieldLabel}" />
                  <Slider Minimum="0.9" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding FontScale}"
                          AutomationProperties.Name="Escala do texto" Margin="0,0,0,10" />
                  <TextBlock Text="Arredondamento" Style="{DynamicResource FieldLabel}" />
                  <Slider Maximum="24" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding CornerRadius}" AutomationProperties.Name="Arredondamento" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Largura do menu" Style="{DynamicResource FieldLabel}" />
                  <Slider Minimum="180" Maximum="320" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding SidebarSize}"
                          AutomationProperties.Name="Largura do menu" Margin="0,0,0,10" />
                  <TextBlock Text="Espaçamento dos controles" Style="{DynamicResource FieldLabel}" />
                  <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Density, Mode=TwoWay}" AutomationProperties.Name="Espaçamento dos controles">
                    <ComboBoxItem Content="Confortável" Tag="Comfortable" />
                    <ComboBoxItem Content="Compacto" Tag="Compact" />
                  </ComboBox>
                </StackPanel>
              </components:ResponsivePanel>
            </StackPanel>
          </Border>
          <Expander x:Name="AdvancedPalette" Header="Editor avançado da paleta" AutomationProperties.AutomationId="AdvancedPalette">
            <Border Style="{DynamicResource Panel}" Margin="0,6,0,0">
              <StackPanel>
                <TextBlock Text="Cores em formato #RRGGBB" Style="{DynamicResource Caption}" Margin="0,0,0,8" />
                <components:ResponsivePanel MinimumColumnWidth="185" Gap="10">
                  <StackPanel><TextBlock Text="Nome do tema" Style="{DynamicResource FieldLabel}" /><TextBox Text="{Binding CustomName}" MaxLength="48" AutomationProperties.Name="Nome do tema" /></StackPanel>
                  <StackPanel><TextBlock Text="Destaque" Style="{DynamicResource FieldLabel}" /><TextBox Text="{Binding CustomAccent}" MaxLength="7" AutomationProperties.Name="Cor de destaque" /></StackPanel>
                  <StackPanel><TextBlock Text="Fundo" Style="{DynamicResource FieldLabel}" /><TextBox Text="{Binding CustomBackground}" MaxLength="7" AutomationProperties.Name="Cor de fundo" /></StackPanel>
                  <StackPanel><TextBlock Text="Menu" Style="{DynamicResource FieldLabel}" /><TextBox Text="{Binding CustomSurface}" MaxLength="7" AutomationProperties.Name="Cor do menu" /></StackPanel>
                  <StackPanel><TextBlock Text="Painéis" Style="{DynamicResource FieldLabel}" /><TextBox Text="{Binding CustomElevated}" MaxLength="7" AutomationProperties.Name="Cor dos painéis" /></StackPanel>
                  <StackPanel><TextBlock Text="Bordas" Style="{DynamicResource FieldLabel}" /><TextBox Text="{Binding CustomBorder}" MaxLength="7" AutomationProperties.Name="Cor das bordas" /></StackPanel>
                  <StackPanel><TextBlock Text="Destaque secundário" Style="{DynamicResource FieldLabel}" /><TextBox Text="{Binding CustomSecondaryAccent}" MaxLength="7" AutomationProperties.Name="Cor de destaque secundária" /></StackPanel>
                  <StackPanel><TextBlock Text="Texto principal" Style="{DynamicResource FieldLabel}" /><TextBox Text="{Binding CustomTextColor}" MaxLength="7" AutomationProperties.Name="Cor do texto principal" /></StackPanel>
                  <StackPanel><TextBlock Text="Texto secundário" Style="{DynamicResource FieldLabel}" /><TextBox Text="{Binding CustomSecondaryText}" MaxLength="7" AutomationProperties.Name="Cor do texto secundário" /></StackPanel>
                </components:ResponsivePanel>
                <Button Content="Salvar tema na biblioteca" Command="{Binding ApplyCustomThemeCommand}" Style="{DynamicResource PrimaryButton}"
                        HorizontalAlignment="Left" Margin="0,12,0,0" />
              </StackPanel>
            </Border>
          </Expander>
          <Expander Header="Importar, exportar e restaurar" Margin="0,4,0,0">
            <WrapPanel Margin="0,7,0,0">
              <Button Content="Importar tema" Command="{Binding ImportThemeCommand}" Margin="0,0,7,7" />
              <Button Content="Exportar tema" Command="{Binding ExportThemeCommand}" Margin="0,0,7,7" />
              <Button Content="Restaurar Red Eclipse" Command="{Binding RestoreThemeCommand}" Margin="0,0,7,7" />
              <Button Content="Remover da biblioteca" Command="{Binding RemoveThemeCommand}" Style="{DynamicResource DangerButton}" Margin="0,0,0,7" />
            </WrapPanel>
          </Expander>
          <TextBlock Text="{Binding Status}" Style="{DynamicResource Caption}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Painel inicial">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{DynamicResource Panel}" Margin="0,0,8,18">
          <StackPanel>
            <TextBlock Text="Dados da última análise" Style="{DynamicResource SectionTitle}" />
            <TextBlock Text="Escolha quais informações aparecem nos detalhes do Início." Style="{DynamicResource Caption}" Margin="0,4,0,10" />
            <ItemsControl ItemsSource="{Binding DashboardWidgets}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{DynamicResource DividerRow}">
                    <DockPanel>
                      <WrapPanel DockPanel.Dock="Right">
                        <Button Content="Subir" Style="{DynamicResource CompactAction}"
                                Command="{Binding DataContext.MoveWidgetUpCommand, RelativeSource={RelativeSource AncestorType=views:SettingsView}}"
                                CommandParameter="{Binding Code}" />
                        <Button Content="Descer" Style="{DynamicResource CompactAction}" Margin="6,0,0,0"
                                Command="{Binding DataContext.MoveWidgetDownCommand, RelativeSource={RelativeSource AncestorType=views:SettingsView}}"
                                CommandParameter="{Binding Code}" />
                      </WrapPanel>
                      <CheckBox Content="{Binding Title}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Som e movimento">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <components:ResponsivePanel DataContext="{Binding Preferences}" MinimumColumnWidth="285" Gap="12" Margin="0,0,8,18">
          <Border Style="{DynamicResource Panel}">
            <StackPanel>
              <TextBlock Text="Som" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8" />
              <CheckBox Content="Ativar sons" IsChecked="{Binding SoundEnabled}" />
              <CheckBox Content="Sons de interface" IsChecked="{Binding InterfaceSounds}" Margin="0,4" />
              <CheckBox Content="Modo silencioso" IsChecked="{Binding SilentMode}" />
              <TextBlock Text="Volume geral" Style="{DynamicResource FieldLabel}" Margin="0,12,0,6" />
              <Slider Maximum="1" Value="{Binding Volume}" AutomationProperties.Name="Volume geral" />
              <TextBlock Text="Volume de notificações" Style="{DynamicResource FieldLabel}" Margin="0,12,0,6" />
              <Slider Maximum="1" Value="{Binding NotificationVolume}" AutomationProperties.Name="Volume das notificações" />
            </StackPanel>
          </Border>
          <Border Style="{DynamicResource Panel}">
            <StackPanel>
              <TextBlock Text="Movimento" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8" />
              <CheckBox Content="Ativar animações e transições" IsChecked="{Binding AnimationsEnabled}" />
              <TextBlock Text="A preferência de redução de movimento do Windows tem prioridade." Style="{DynamicResource Caption}" Margin="0,5,0,0" />
            </StackPanel>
          </Border>
        </components:ResponsivePanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Sobre">
      <Border Style="{DynamicResource Panel}" VerticalAlignment="Top" Margin="0,0,8,18">
        <StackPanel>
          <TextBlock Text="PHsystem Next" Style="{DynamicResource SectionTitle}" />
          <TextBlock Text="{Binding ApplicationVersion}" Margin="0,5,0,0" />
          <Expander Header="Versão e serviços" Margin="0,9,0,0">
            <StackPanel Margin="0,6,0,0">
              <TextBlock Text="{Binding DesktopBuildId, StringFormat={}Build {0}}" />
              <TextBlock Text="{Binding SourceCommit, StringFormat={}Commit {0}}" />
              <TextBlock Text="{Binding ContractVersion}" />
              <TextBlock Text="{Binding Community.ConnectionSummary}" Style="{DynamicResource Caption}" Margin="0,8,0,0" />
              <TextBlock Text="{Binding Community.ApiVersionSummary}" Style="{DynamicResource Caption}" />
              <TextBlock Text="{Binding Community.MigrationSummary, StringFormat={}Migrações {0}}" Style="{DynamicResource Caption}" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </Border>
    </TabItem>
  </TabControl>
</UserControl>
