<UserControl x:Class="PHsystem.Desktop.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PHsystem.Desktop"
             xmlns:components="clr-namespace:PHsystem.Desktop.Components">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <local:ByteSizeConverter x:Key="BytesLabel" />
  </UserControl.Resources>
  <TabControl>
    <TabItem Header="Volumes">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,18">
          <Border Style="{DynamicResource HeroPanel}" Margin="0,0,0,14">
            <DockPanel>
              <Button Content="Atualizar volumes" Command="{Binding ScanCommand}" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" />
              <StackPanel>
                <TextBlock Text="Espaço local disponível" Style="{DynamicResource Caption}" />
                <TextBlock Text="{Binding StorageAvailable}" Style="{DynamicResource MetricNumber}" Margin="0,4,0,2" />
                <TextBlock Text="{Binding StorageDetail}" Style="{DynamicResource Caption}" />
              </StackPanel>
            </DockPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding Volumes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><components:ResponsivePanel MinimumColumnWidth="230" Gap="12" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{DynamicResource Panel}">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock Text="{Binding Capacity}" DockPanel.Dock="Right" Style="{DynamicResource Caption}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" Style="{DynamicResource SectionTitle}" />
                    </DockPanel>
                    <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Height="6" Margin="0,10,0,7"
                                 AutomationProperties.Name="{Binding Name, StringFormat={}Ocupação de {0}}" />
                    <DockPanel>
                      <TextBlock Text="{Binding UsedPercent, StringFormat={}{0:N0}% usado}" DockPanel.Dock="Right" Style="{DynamicResource Caption}" />
                      <TextBlock Text="{Binding Available}" />
                    </DockPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Explorar pasta">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,18">
          <Border Style="{DynamicResource HeroPanel}" Margin="0,0,0,12">
            <StackPanel>
              <DockPanel>
                <Button Content="Escolher pasta…" Command="{Binding SelectStorageDirectoryCommand}" DockPanel.Dock="Right" Margin="10,0,0,0" />
                <StackPanel>
                  <TextBlock Text="Pasta para analisar" Style="{DynamicResource SectionTitle}" />
                  <TextBlock Text="{Binding StorageDirectory}" Style="{DynamicResource Caption}" Margin="0,3,0,0" />
                </StackPanel>
              </DockPanel>
              <StackPanel Margin="0,10,0,0" Visibility="{Binding HasStorageDirectory, Converter={StaticResource BoolVisibility}}">
                <CheckBox Content="Permito examinar os nomes e tamanhos dos arquivos desta pasta." IsChecked="{Binding StorageConsent}" />
                <CheckBox Content="Procurar arquivos com conteúdo idêntico (SHA-256)" IsChecked="{Binding CompareHashes}" Margin="0,3,0,9" />
                <Button Content="Analisar pasta" Command="{Binding AnalyzeStorageCommand}" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding StorageResultLabel}" Style="{DynamicResource Caption}" AutomationProperties.LiveSetting="Polite" Margin="0,8,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{DynamicResource TablePanel}" Visibility="{Binding HasStorageResult, Converter={StaticResource BoolVisibility}}">
            <StackPanel Margin="12">
              <TabControl>
                <TabItem Header="Maiores arquivos">
                  <DataGrid ItemsSource="{Binding StorageFiles}" MaxHeight="360" AutomationProperties.Name="Maiores arquivos da pasta">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Caminho" Binding="{Binding Path}" Width="*" />
                      <DataGridTextColumn Header="Tamanho" Binding="{Binding Bytes, Converter={StaticResource BytesLabel}}" Width="126" />
                    </DataGrid.Columns>
                  </DataGrid>
                </TabItem>
                <TabItem Header="Duplicados">
                  <StackPanel>
                    <TextBlock Style="{DynamicResource Caption}" Margin="0,0,0,8" Text="{Binding DuplicateResultLabel}" />
                    <ItemsControl ItemsSource="{Binding DuplicateFiles}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{DynamicResource DividerRow}"><TextBlock Text="{Binding}" /></Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </TabItem>
              </TabControl>
            </StackPanel>
          </Border>
          <Expander Header="Limites da análise" Margin="0,8,0,0">
            <TextBlock Text="Somente leitura. Até 20.000 arquivos, 5.000 pastas e 60 segundos. A comparação de conteúdo examina até 256 MiB por arquivo e 1 GiB no total. Os caminhos ficam na memória local." Style="{DynamicResource Caption}" Margin="0,6,0,0" />
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>
