<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PHsystem.Desktop" xmlns:components="clr-namespace:PHsystem.Desktop.Components" SizeChanged="LayoutChanged" x:Class="PHsystem.Desktop.Views.AuthenticationView" Unloaded="ViewUnloaded">
  <UserControl.Resources>
    <Style x:Key="WelcomeOnly" TargetType="StackPanel">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Page}" Value="{x:Static local:AuthenticationPage.Welcome}">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LoginOnly" TargetType="StackPanel">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Page}" Value="{x:Static local:AuthenticationPage.Login}">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RegisterOnly" TargetType="StackPanel">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Page}" Value="{x:Static local:AuthenticationPage.Register}">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  </UserControl.Resources>
  <ScrollViewer Background="{DynamicResource BackgroundBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24" MaxWidth="860" HorizontalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="BrandColumn" Width="*"/>
        <ColumnDefinition Width="420"/>
      </Grid.ColumnDefinitions>
      <StackPanel x:Name="BrandPanel" VerticalAlignment="Center" Margin="0,12,30,0">
        <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource AccentMutedBrush}" HorizontalAlignment="Left" Margin="0,0,0,26">
          <components:IconControl Data="M5,20 V4 H13 Q20,4 20,10 Q20,16 13,16 H5 M10,9 H14" Width="32" Height="32" Stroke="{DynamicResource AccentBrush}"/>
        </Border>
        <TextBlock Text="PHsystem" FontSize="32" FontWeight="SemiBold" LineHeight="44"/>
      </StackPanel>
      <Border Grid.Column="1" Style="{DynamicResource HeroPanel}" Padding="22" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="23" FontWeight="SemiBold" LineHeight="30" Margin="0,0,0,13"/>
          <Border Margin="0,0,0,13" Style="{DynamicResource Notice}">
            <StackPanel>
              <TextBlock Text="{Binding ConnectionMessage}" FontSize="12" AutomationProperties.AutomationId="ConnectionMessage" AutomationProperties.LiveSetting="Polite"/>
              <Button Content="Tentar novamente" Command="{Binding RetryCommand}" HorizontalAlignment="Left"
                      Style="{DynamicResource SubtleAction}" Margin="0,2,0,0" AutomationProperties.AutomationId="RetryConnection"/>
              <Expander Header="Detalhes da conexão" Margin="0,3,0,0">
                <TextBlock Text="{Binding ConnectionDetail}" Style="{DynamicResource Caption}" Margin="0,5,0,0"/>
              </Expander>
            </StackPanel>
          </Border>
          <StackPanel Style="{StaticResource WelcomeOnly}">
            <Button Content="Entrar" Click="OpenLogin" IsEnabled="{Binding CanLogin}" Style="{DynamicResource PrimaryButton}" MinHeight="42"/>
            <Button Content="Criar conta" Click="CreateAccount" IsEnabled="{Binding CanCreateAccount}" Margin="0,8,0,0"/>
            <Expander Header="Entrar com Google" Margin="0,6,0,0">
              <StackPanel Margin="0,6,0,0">
                <CheckBox Content="Aceito os termos e a política de privacidade" IsChecked="{Binding AcceptTerms}"/>
                <Button Content="Continuar no navegador" Command="{Binding GoogleLoginCommand}" IsEnabled="{Binding IsReady}" HorizontalAlignment="Left" Margin="0,7,0,0"/>
                <Button Content="Cancelar autenticação Google" Command="{Binding CancelGoogleCommand}" Style="{DynamicResource SubtleAction}" HorizontalAlignment="Left" Visibility="{Binding IsGooglePending, Converter={StaticResource BoolVisibility}}"/>
              </StackPanel>
            </Expander>
            <Button Content="Voltar ao diagnóstico local" Command="{Binding ReturnToLocalCommand}" Style="{DynamicResource SubtleAction}" Margin="0,8,0,0"/>
          </StackPanel>
          <StackPanel x:Name="FormPanel" IsEnabled="{Binding IsReady}">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Page}" Value="{x:Static local:AuthenticationPage.Welcome}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Page}" Value="{x:Static local:AuthenticationPage.Terms}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Page}" Value="{x:Static local:AuthenticationPage.Privacy}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <StackPanel Style="{StaticResource LoginOnly}">
              <TextBlock Text="Nome de usuário" Style="{DynamicResource FieldLabel}"/>
              <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Usuário para entrar"/>
              <TextBlock Text="Senha" Style="{DynamicResource FieldLabel}" Margin="0,14,0,6"/>
              <PasswordBox x:Name="LoginPassword" AutomationProperties.Name="Senha para entrar"/>
              <Expander Header="Código de autenticação em duas etapas" Margin="0,6,0,0">
                <TextBox Text="{Binding MfaCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" AutomationProperties.Name="Código MFA" Margin="0,5,0,0"/>
              </Expander>
              <CheckBox Content="Lembrar minha sessão" IsChecked="{Binding RememberSession}" Margin="0,12,0,0"/>
              <Button Content="Confirmar e-mail" Click="OpenConfirmation" Style="{DynamicResource QuietButton}" HorizontalAlignment="Left" Padding="0,8"/>
              <Button Content="Recuperar senha" Style="{DynamicResource QuietButton}" Click="OpenRecovery" HorizontalAlignment="Left" Padding="0,8"/>
            </StackPanel>
            <StackPanel Style="{StaticResource RegisterOnly}">
              <TextBlock Text="Nome de usuário" Style="{DynamicResource FieldLabel}"/>
              <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Novo nome de usuário"/>
              <TextBlock Text="E-mail" Style="{DynamicResource FieldLabel}" Margin="0,14,0,6"/>
              <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="E-mail de cadastro"/>
              <TextBlock Text="Senha" Style="{DynamicResource FieldLabel}" Margin="0,14,0,6"/>
              <PasswordBox x:Name="RegisterPassword" PasswordChanged="PasswordChanged" AutomationProperties.Name="Nova senha"/>
              <ProgressBar Value="{Binding PasswordStrength, Mode=OneWay}" Maximum="6" Height="3" Margin="0,10,0,8"/>
              <TextBlock Text="{Binding PasswordFeedback}" Style="{DynamicResource Caption}"/>
              <TextBlock Text="Confirmar senha" Style="{DynamicResource FieldLabel}" Margin="0,14,0,6"/>
              <PasswordBox x:Name="RegisterConfirmation" AutomationProperties.Name="Confirmação da nova senha"/>
              <CheckBox Content="Li e aceito os termos e a privacidade" IsChecked="{Binding AcceptTerms}" Margin="0,16,0,12"/>
            </StackPanel>
            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Page}" Value="{x:Static local:AuthenticationPage.Recovery}">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="E-mail da conta" Style="{DynamicResource FieldLabel}"/>
              <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="E-mail para recuperação"/>
            </StackPanel>
            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Page}" Value="{x:Static local:AuthenticationPage.ConfirmEmail}">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Page}" Value="{x:Static local:AuthenticationPage.ResetPassword}">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="E-mail da conta" Style="{DynamicResource FieldLabel}"/>
              <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="E-mail para confirmação"/>
              <Button Content="Reenviar confirmação" Command="{Binding ResendEmailCommand}" HorizontalAlignment="Left" Style="{DynamicResource QuietButton}" Margin="0,8,0,12"/>
              <TextBlock Text="ID recebido por e-mail" Style="{DynamicResource FieldLabel}"/>
              <TextBox Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock Text="Token recebido por e-mail" Style="{DynamicResource FieldLabel}" Margin="0,14,0,6"/>
              <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Page}" Value="{x:Static local:AuthenticationPage.ResetPassword}">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="Nova senha" Style="{DynamicResource FieldLabel}" Margin="0,14,0,6"/>
              <PasswordBox x:Name="ResetPassword"/>
              <TextBlock Text="Confirmar nova senha" Style="{DynamicResource FieldLabel}" Margin="0,14,0,6"/>
              <PasswordBox x:Name="ResetConfirmation"/>
            </StackPanel>
            <Button Content="Continuar" IsEnabled="{Binding CanSubmit}" Click="Submit" Style="{DynamicResource PrimaryButton}" MinHeight="38" Margin="0,18,0,0"/>
            <Button Content="Voltar" Click="Back" Style="{DynamicResource QuietButton}" Margin="0,8,0,0"/>
          </StackPanel>
          <TextBlock x:Name="LegalText">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Page}" Value="{x:Static local:AuthenticationPage.Terms}">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Page}" Value="{x:Static local:AuthenticationPage.Privacy}">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Button Content="Início" Click="Back" HorizontalAlignment="Left">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Page}" Value="{x:Static local:AuthenticationPage.Terms}">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Page}" Value="{x:Static local:AuthenticationPage.Privacy}">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <TextBlock Text="{Binding Status}" Foreground="{DynamicResource WarningBrush}" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
          <WrapPanel Margin="0,20,0,0">
            <Button Content="Termos" Click="OpenTerms" Style="{DynamicResource QuietButton}" Padding="7,5"/>
            <Button Content="Privacidade" Click="OpenPrivacy" Style="{DynamicResource QuietButton}" Padding="7,5"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
