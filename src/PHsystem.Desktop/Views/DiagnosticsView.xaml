<UserControl x:Class="PHsystem.Desktop.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PHsystem.Desktop.Views">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility" /></UserControl.Resources>
  <TabControl>
    <TabItem Header="Resumo"><views:ResultsSummaryView /></TabItem>
    <TabItem Header="Componentes">
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="150" MaxWidth="235" />
          <ColumnDefinition Width="2.7*" />
        </Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,12,0">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Buscar componente" Style="{DynamicResource FieldLabel}" />
            <TextBox Text="{Binding CategoryFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar por nome ou estado" />
          </StackPanel>
          <ListBox ItemsSource="{Binding FilteredCategories}" SelectedItem="{Binding SelectedCategory}" AutomationProperties.AutomationId="DiagnosticCategories">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding State}" Style="{DynamicResource Caption}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
        <Border Grid.Column="1" Style="{DynamicResource Panel}">
          <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel DataContext="{Binding SelectedCategory}" Margin="0,0,8,0">
                <DockPanel Margin="0,0,0,10">
                  <Border Style="{DynamicResource StateBadge}" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding State}" FontSize="11" />
                  </Border>
                  <TextBlock Text="{Binding Name}" Style="{DynamicResource SectionTitle}" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding Facts}" MaxHeight="490" AutomationProperties.Name="Informações do componente">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Informação" Binding="{Binding Name}" Width="1*" />
                    <DataGridTemplateColumn Header="Valor" Width="1.6*" SortMemberPath="Value">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding Value}" TextWrapping="Wrap" Margin="0,5" /></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding Errors}" Foreground="{DynamicResource WarningBrush}" Margin="0,10,0,0"
                           Visibility="{Binding HasErrors, Converter={StaticResource BoolVisibility}}" />
                <Expander Header="Origem e validade" Margin="0,8,0,0">
                  <StackPanel Margin="0,6,0,0">
                    <TextBlock Text="{Binding Source}" Style="{DynamicResource Caption}" />
                    <TextBlock Text="{Binding ExpiresAt}" Style="{DynamicResource Caption}" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
            <Border Background="{DynamicResource PanelBrush}">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedCategory}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="Selecione um resultado da lista." HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource Caption}" />
            </Border>
          </Grid>
        </Border>
      </Grid>
    </TabItem>
    <TabItem Header="Rede / testes">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border DataContext="{Binding NetworkLab}" Style="{DynamicResource Panel}" MaxWidth="780" HorizontalAlignment="Left" Margin="0,0,8,12">
          <StackPanel>
            <TextBlock Text="Teste de conexão" Style="{DynamicResource SectionTitle}" Margin="0,0,0,12" />
            <TextBlock Text="Endereço do servidor ou IP" Style="{DynamicResource FieldLabel}" />
            <DockPanel>
              <Button Content="Testar DNS e ping" Command="{Binding StartCommand}" Style="{DynamicResource PrimaryButton}"
                      DockPanel.Dock="Right" Margin="8,0,0,0" />
              <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" MinWidth="220" AutomationProperties.Name="Endereço do servidor ou IP" />
            </DockPanel>
            <WrapPanel Margin="0,7,0,0">
              <Expander Header="Opções do teste" Margin="0,0,8,0">
                <CheckBox Content="Usar o ping do Windows" IsChecked="{Binding UseWindowsPing}" Margin="0,7,0,0" />
              </Expander>
              <Button Content="Interromper teste" Command="{Binding CancelCommand}" Style="{DynamicResource SubtleAction}" />
            </WrapPanel>
            <Border Style="{DynamicResource Notice}" Margin="0,10,0,0">
              <TextBlock Text="{Binding Result}" AutomationProperties.LiveSetting="Polite" />
            </Border>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Avaliação de saúde">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,16">
          <Border Style="{DynamicResource HeroPanel}" Margin="0,0,0,12">
            <DockPanel>
              <Button Content="Exportar relatório reduzido" Command="{Binding ExportSafeReportCommand}" DockPanel.Dock="Right"
                      VerticalAlignment="Center" Margin="10,0,0,0" />
              <StackPanel>
                <TextBlock Text="{Binding HealthLabel}" Style="{DynamicResource SectionTitle}" />
                <TextBlock Text="{Binding HealthCoverage}" Style="{DynamicResource Caption}" Margin="0,4,0,0" />
              </StackPanel>
            </DockPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding HealthDimensions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{DynamicResource Panel}" Margin="0,0,0,8" Padding="14">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock Text="{Binding Display}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" Margin="8,0,0,0" />
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Text="{Binding Status}" Style="{DynamicResource Caption}" Margin="0,3,0,0" />
                    <Expander Header="Leitura e origem" Margin="0,4,0,0">
                      <StackPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding Evidence}" />
                        <TextBlock Text="{Binding Source}" Style="{DynamicResource Caption}" Margin="0,4,0,0" />
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Expander Header="Como a avaliação é calculada">
            <TextBlock Text="{Binding HealthExplanation}" Style="{DynamicResource Caption}" Margin="0,7,0,0" />
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Investigar travamentos">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,16">
          <Border Style="{DynamicResource HeroPanel}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="{Binding StabilitySummary}" Style="{DynamicResource SectionTitle}" />
              <TextBlock Text="{Binding StabilityScope}" Style="{DynamicResource Caption}" Margin="0,5,0,0" />
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding StabilityEvents}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{DynamicResource Panel}" Padding="14" Margin="0,0,0,8">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock Text="{Binding At, StringFormat={}{0:dd/MM/yyyy HH:mm:ss zzz}}" DockPanel.Dock="Right" Style="{DynamicResource Caption}" Margin="8,0,0,0" />
                      <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" />
                    </DockPanel>
                    <Expander Header="Detalhes do evento" Margin="0,4,0,0">
                      <StackPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding Provider}" />
                        <TextBlock Text="{Binding EventId, StringFormat={}Evento {0}}" />
                        <TextBlock Text="{Binding Context}" Style="{DynamicResource Caption}" Margin="0,5,0,0" />
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Ferramentas oficiais">
      <Border Style="{DynamicResource Panel}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Abrir ferramentas do Windows" Style="{DynamicResource SectionTitle}" Margin="0,0,0,10" />
          <Button Content="Segurança do Windows" Command="{Binding OpenWindowsSecurityCommand}" Style="{DynamicResource ActionRow}" />
          <Button Content="Windows Update" Command="{Binding OpenWindowsUpdateCommand}" Style="{DynamicResource ActionRow}" />
          <Button Content="Aplicativos de inicialização" Command="{Binding OpenStartupSettingsCommand}" Style="{DynamicResource ActionRow}" Margin="0" />
        </StackPanel>
      </Border>
    </TabItem>
  </TabControl>
</UserControl>
